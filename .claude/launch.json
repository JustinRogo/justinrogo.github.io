{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "site",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8766"
      ],
      "port": 8766
    },
    {
      "name": "site-alt",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8771",
        "--bind",
        "127.0.0.1"
      ],
      "port": 8771,
      "autoPort": false
    },
    {
      "name": "v2",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "v2/serve.mjs",
        "--watch"
      ],
      "port": 4392
    }
  ]
}
